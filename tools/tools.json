        "type": "function",
        "function": {
            "name": "readl",
            "description": "读取指定文件指定范围行",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "指定文件的绝对路径"
                    },
                    "start": {
                        "type": "number",
                        "description": "指定读取的起始行，为n则从第n行开始读取（包含第n行），小于等于1或不携带此参数则从文件开头开始读取"
                    },
                    "end": {
                        "type": "number",
                        "description": "必需参数，指定读取的结束行，为n则读取到第n行结束（包含第n行），若大于文件行数则读取到文件末尾，若与start参数相同则读取单行文本"
                    }

                },
                "required": ["path", "end"]
            }
        }
